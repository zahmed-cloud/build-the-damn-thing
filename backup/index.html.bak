<script>
/* ================================================================
   BUILD THE DAMN THING — all-in-one JS
   ================================================================ */

/* mark body for CSS scroll animations */
document.documentElement.classList.add('js');

/* ═══ shared pixel character ═══ */
var BOTP = {O:'#1d1410', B:'#e0603a', S:'#bb4a2a', F:'#241f1c', E:'#f2ede1', A:'#34a96a'};
var FR = [
  "....OAO....",
  "....OOO....",
  "..OOOOOOO..",
  ".OBBBBBBBO.",
  ".OBFFFFFBO.",
  ".OBFEFFEBO.",
  ".OBFFFFFBO.",
  ".OBBBBBBBO.",
  ".OSSSSSSSO.",
  "OBBBBBBBBBO",
  "OBSSSSSSSBO",
  "OBSSSSSSSBO",
  "..OO...OO..",
  "..OB...BO.."
];
var FB = [
  "....OAO....",
  "....OOO....",
  "..OOOOOOO..",
  ".OBBBBBBBO.",
  ".OBFFFFFBO.",
  ".OBFEFFEBO.",
  ".OBFFFFFBO.",
  ".OBBBBBBBO.",
  ".OSSSSSSSO.",
  "OBBBBBBBBBO",
  "OBSSSSSSSBO",
  "OBSSSSSSSBO",
  "...OOOO....",
  "...OB.BO..."
];

function drawSprite(x, mat, ox, oy, un, flip) {
  var w = mat[0].length;
  for (var r = 0; r < mat.length; r++) {
    var row = mat[r];
    for (var i = 0; i < row.length; i++) {
      var ch = flip ? row[w - 1 - i] : row[i];
      var col = BOTP[ch];
      if (!col) continue;
      x.fillStyle = col;
      x.fillRect(Math.floor(ox + i * un), Math.floor(oy + r * un), Math.ceil(un), Math.ceil(un));
    }
  }
}

function fitCanvas(cv) {
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  var r = cv.getBoundingClientRect();
  var w = r.width, h = r.height;
  /* guard against zero dimensions — the #1 cause of blank canvases */
  if (w < 1 || h < 1) return {x: null, w: 0, h: 0, ok: false};
  cv.width = Math.round(w * dpr);
  cv.height = Math.round(h * dpr);
  var x = cv.getContext('2d');
  x.setTransform(dpr, 0, 0, dpr, 0, 0);
  x.imageSmoothingEnabled = false;
  return {x: x, w: w, h: h, ok: true};
}

/* ═══ IntersectionObserver — pause off-screen canvases, animate sections ═══ */
var canvasVis = {};
(function() {
  if (typeof IntersectionObserver === 'undefined') {
    canvasVis = {heroCanvas:true, stageCanvas:true, catchCanvas:true, solveCanvas:true, weekCanvas:true};
    return;
  }
  var cObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { canvasVis[e.target.id] = e.isIntersecting; });
  }, {threshold: 0.02});
  ['heroCanvas','stageCanvas','catchCanvas','solveCanvas','weekCanvas'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) { cObs.observe(el); canvasVis[id] = false; }
  });
  /* section scroll-in animations */
  var sObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) { if (e.isIntersecting) { e.target.classList.add('visible'); } });
  }, {threshold: 0.08});
  document.querySelectorAll('.sec').forEach(function(s) { sObs.observe(s); });
})();

/* ═══ score HUD shared state ═══ */
var GAME = (function() {
  var lv = 0, money = 0;
  var L = document.getElementById('hudLV'), M = document.getElementById('hudMoney');
  function bump(el) { if (!el) return; el.classList.add('bump'); setTimeout(function() { el.classList.remove('bump'); }, 200); }
  function rL() { if (L) { L.textContent = 'LV ' + String(lv).padStart(2, '0'); bump(L); } }
  function rM() { if (M) { M.textContent = '$' + money.toLocaleString() + '/$10K'; bump(M); } }
  return {
    addCash: function(n) { money = Math.min(10000, money + n); rM(); return money; },
    lvlUp: function() { lv++; rL(); return lv; },
    get money() { return money; },
    get lv() { return lv; }
  };
})();

function toast(msg) {
  var t = document.getElementById('toast');
  if (!t) return;
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._h);
  t._h = setTimeout(function() { t.classList.remove('show'); }, 2400);
}

var REFIT = [];

/* ═══ sound + voice ═══ */
var SND = (function() {
  var on = true, ctx = null, voice = null;

  function ensure() {
    if (!ctx) { try { ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch(e) {} }
    if (ctx && ctx.state === 'suspended') { try { ctx.resume(); } catch(e) {} }
  }

  function beep(freq, dur, type, vol) {
    if (!on) return; ensure(); if (!ctx) return;
    try {
      var o = ctx.createOscillator(), gn = ctx.createGain();
      o.type = type || 'square'; o.frequency.value = freq;
      gn.gain.value = vol || 0.05;
      o.connect(gn); gn.connect(ctx.destination);
      var t = ctx.currentTime;
      o.start(t);
      gn.gain.setValueAtTime(gn.gain.value, t);
      gn.gain.exponentialRampToValueAtTime(0.0001, t + (dur || 0.08));
      o.stop(t + (dur || 0.08));
    } catch(e) {}
  }

  /* ---------- VOICE SELECTION ----------
     Priority: known male voices > unknown English voices > anything
     Hard block: known female voices get -500 so they never win */
  function pick() {
    if (!('speechSynthesis' in window)) return;
    var vs = speechSynthesis.getVoices();
    if (!vs.length) return;

    var maleAllow = /\b(daniel|lee|james|oliver|arthur|rishi|liam|jack|russell|tom|thomas|ralph|albert|aaron|fred|alex|gordon|george|harry|william|david|mark|paul|guy|reed|otis|rocko|samson|grandpa|eddy|ralph|malcolm|bruce|evan|jorge|diego|luciano|jacques|xander)\b/i;
    var malePat  = /\b(male)\b/i;
    var femBlock = /\b(female|karen|catherine|samantha|victoria|tessa|moira|fiona|zira|hazel|serena|ava|allison|susan|siri|nicky|veena|kate|kathy|princess|joana|lesya|linh|luciana|mariska|meijia|melina|milena|montse|noora|paulina|sara|shelley|siobhan|tina|zosia|agnes|amelie|anna|carmit|damayanti|ellen|flo|grandma|helena|ioana|jessica|kanya|kyoko|lana|laura|lekha|maged|majed|mei|sandy|rong|tingting|yuna|o-ren|tunde)\b/i;

    function sc(v) {
      var s = 0, lang = v.lang || '', name = v.name || '';
      /* language: prefer AU > GB > US > other English */
      if (/en[-_]?au/i.test(lang)) s += 40;
      else if (/en[-_]?gb/i.test(lang)) s += 28;
      else if (/en[-_]?us/i.test(lang)) s += 12;
      else if (/^en/i.test(lang)) s += 6;
      else s -= 100;
      /* male allow-list */
      if (maleAllow.test(name)) s += 60;
      /* generic "male" in name (not "female") */
      if (malePat.test(name) && !femBlock.test(name)) s += 55;
      /* female hard block */
      if (femBlock.test(name)) s -= 500;
      return s;
    }

    var sorted = vs.slice().sort(function(a, b) { return sc(b) - sc(a); });
    voice = sorted[0] || null;
  }

  if ('speechSynthesis' in window) { pick(); speechSynthesis.onvoiceschanged = pick; }

  function norm(t) {
    t = String(t);
    t = t.replace(/[\u25b6\u2192\u2191\u2193\u2713\u2715\u2014\u00b7]/g, ' ');
    t = t.replace(/[\u{1F000}-\u{1FFFF}]/gu, ' ');
    t = t.replace(/\$?\b(\d+)\s*[kK]\b/g, function(m, d) { return d + ' thousand dollars'; });
    t = t.replace(/\$\s?(\d[\d,]*)/g, function(m, d) { return d.replace(/,/g, '') + ' dollars'; });
    t = t.replace(/\bwk\s*0*(\d+)/ig, 'week $1');
    t = t.replace(/\blv\s*0*(\d+)/ig, 'level $1');
    t = t.replace(/\blevel\s*0*(\d+)/ig, 'level $1');
    t = t.replace(/\+/g, ' plus ');
    t = t.replace(/\b0+(\d)/g, '$1');
    t = t.replace(/\s+/g, ' ').trim();
    return t;
  }

  return {
    get on() { return on; },
    toggle: function() { on = !on; ensure(); if (!on && 'speechSynthesis' in window) speechSynthesis.cancel(); return on; },
    blip: function() { beep(660, 0.06, 'square', 0.035); },
    add: function() { beep(880, 0.05, 'square', 0.04); },
    bad: function() { beep(170, 0.16, 'sawtooth', 0.05); },
    coin: function() { beep(1180, 0.05, 'square', 0.045); setTimeout(function() { beep(1560, 0.07, 'square', 0.04); }, 45); },
    good: function() { beep(720, 0.08, 'square', 0.05); setTimeout(function() { beep(1040, 0.1, 'square', 0.05); }, 70); },
    win: function() { [523,659,784,1046].forEach(function(fr, i) { setTimeout(function() { beep(fr, 0.12, 'square', 0.05); }, i * 90); }); },
    say: function(text) {
      if (!on || !('speechSynthesis' in window)) return;
      ensure();
      try {
        speechSynthesis.cancel();
        var u = new SpeechSynthesisUtterance(norm(text));
        if (voice) u.voice = voice;
        u.rate = 1.04 + Math.random() * 0.1;
        u.pitch = 0.92 + Math.random() * 0.12;
        u.volume = 1;
        speechSynthesis.speak(u);
      } catch(e) {}
    }
  };
})();
window.SND = SND;

/* ═══ HERO — pixel sky, clouds, birds, flowers, roaming character ═══ */
(function() {
  var c = document.getElementById('heroCanvas');
  if (!c) return;
  var W = 0, H = 0, u = 4, gt = 0;
  var CLOUD = ["...XXXX.....","..XXXXXXXX...",".XXXXXXXXXXX.","XXXXXXXXXXXX.",".XXXXXXXXXX.."];
  var CLOUD2 = ["..XXX..","..XXXX.",".XXXXXX","XXXXXXX",".XXXXX."];
  var clouds = [], spark = [], flowers = [], birds = [], ch = null;
  var autoTimer = 0;

  var HEROLINES = [
    'oi, lets give this a crack',
    'bloody hell that actually worked',
    'righto, onto the next one',
    'sending it, watch this',
    'easy money, lets go',
    'yeah nah this is gonna be sick',
    'built different, dont @ me',
    'lock in, here we go',
    'oi you still watchin?',
    'this is the fun part mate',
    'no worries, we will fix it',
    'too easy, next one',
    'ship it and see what happens',
    'aint no one outworking us',
    'trust the process yeah',
    'oh we are cooking now',
    'alright this ones gonna slap',
    'peak performance right here',
    'watch and learn legends',
    'full send, no cap',
    'we dont do half measures',
    'reckon thats a banger',
    'you seeing this or what',
    'absolute scenes right now'
  ];

  function build() {
    var m = fitCanvas(c);
    if (!m.ok) { setTimeout(build, 120); return; }
    W = m.w; H = m.h;
    u = Math.max(3, Math.min(6, Math.round(W / 240)));
    gt = H * 0.81;
    /* clouds */
    clouds = [];
    var nc = W < 700 ? 5 : 9;
    for (var i = 0; i < nc; i++) {
      var ly = Math.random();
      clouds.push({
        x: Math.random() * W, y: 18 + Math.random() * (H * 0.40),
        sp: 0.08 + ly * 0.3, sc: (1.8 + ly * 2.5) * (u / 4),
        a: 0.55 + ly * 0.4, shape: Math.random() > 0.45 ? CLOUD : CLOUD2
      });
    }
    /* sparkles */
    spark = [];
    for (var i = 0; i < 18; i++) spark.push({x: Math.random() * W, y: Math.random() * H * 0.55, ph: Math.random() * 6.28});
    /* flowers along grass line */
    flowers = [];
    var flowerColors = ['#ff6b8a','#ffb347','#ff85c0','#ffd64a','#ff7eb3','#e8a0ff'];
    for (var i = 0; i < Math.floor(W / 60); i++) {
      flowers.push({x: Math.random() * W, c: flowerColors[(Math.random() * flowerColors.length) | 0], ph: Math.random() * 6.28, size: 0.6 + Math.random() * 0.5});
    }
    /* birds */
    birds = [];
    /* character init */
    if (!ch) ch = {x: W * 0.5, dir: 1, frame: 0, ft: 0, vy: 0, y: 0, grounded: true, sayT: 0, sayS: ''};
  }

  function drawCloud(x, mat, ox, oy, un) {
    for (var r = 0; r < mat.length; r++)
      for (var i = 0; i < mat[r].length; i++) {
        if (mat[r][i] !== 'X') continue;
        x.fillStyle = '#ffffff';
        x.fillRect(Math.floor(ox + i * un), Math.floor(oy + r * un), Math.ceil(un), Math.ceil(un));
      }
  }

  c.addEventListener('click', function(e) {
    var r = c.getBoundingClientRect();
    var cx = e.clientX - r.left;
    if (Math.abs(cx - ch.x) < u * 12) {
      if (ch.grounded) { ch.vy = -7.5; ch.grounded = false; }
      ch.sayS = HEROLINES[(Math.random() * HEROLINES.length) | 0];
      ch.sayT = 80;
      autoTimer = 0;
      SND.say(ch.sayS);
      SND.blip();
    }
  });

  function frame() {
    if (!canvasVis.heroCanvas) { requestAnimationFrame(frame); return; }
    if (W < 1) { requestAnimationFrame(frame); return; }
    var x = c.getContext('2d');
    var f = Date.now() / 1000;

    /* sky gradient */
    var g = x.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#4aa8e3');
    g.addColorStop(0.5, '#7cc6ee');
    g.addColorStop(0.75, '#a5daf5');
    g.addColorStop(1, '#c8ecfb');
    x.fillStyle = g;
    x.fillRect(0, 0, W, H);

    /* sun with animated glow */
    var sx = W - u * 18, sy = u * 14, sr = u * 7;
    var glowPulse = 1 + Math.sin(f * 1.5) * 0.15;
    x.fillStyle = 'rgba(255,224,110,0.15)';
    x.beginPath(); x.arc(sx, sy, sr + u * 5 * glowPulse, 0, 7); x.fill();
    x.fillStyle = 'rgba(255,224,110,0.25)';
    x.beginPath(); x.arc(sx, sy, sr + u * 2.5 * glowPulse, 0, 7); x.fill();
    x.fillStyle = '#ffd64a';
    x.beginPath(); x.arc(sx, sy, sr, 0, 7); x.fill();
    x.fillStyle = '#ffe98c';
    x.beginPath(); x.arc(sx - u, sy - u, sr * 0.5, 0, 7); x.fill();

    /* sparkles */
    spark.forEach(function(s) {
      var tw = 0.25 + 0.65 * Math.abs(Math.sin(f * 2.5 + s.ph));
      x.fillStyle = 'rgba(255,255,255,' + tw.toFixed(2) + ')';
      x.fillRect(s.x, s.y, u * 0.7, u * 0.7);
      x.fillRect(s.x - u * 0.6, s.y + u * 0.15, u * 0.4, u * 0.4);
      x.fillRect(s.x + u * 0.8, s.y + u * 0.15, u * 0.4, u * 0.4);
      x.fillRect(s.x + u * 0.15, s.y - u * 0.5, u * 0.4, u * 0.4);
      x.fillRect(s.x + u * 0.15, s.y + u * 0.8, u * 0.4, u * 0.4);
    });

    /* clouds */
    clouds.forEach(function(cl) {
      cl.x -= cl.sp;
      if (cl.x < -cl.shape[0].length * cl.sc) cl.x = W + 20 + Math.random() * 40;
      x.globalAlpha = cl.a;
      drawCloud(x, cl.shape, cl.x, cl.y, cl.sc);
      x.globalAlpha = 1;
    });

    /* birds */
    birds.forEach(function(b) {
      b.x += b.vx;
      b.py += Math.sin(f * 3 + b.ph) * 0.15;
      var wing = Math.sin(f * 8 + b.ph) * u * 0.8;
      x.fillStyle = '#3a3530';
      x.fillRect(b.x - u * 0.8, b.py - wing, u * 0.5, u * 0.5);
      x.fillRect(b.x, b.py, u * 0.5, u * 0.5);
      x.fillRect(b.x + u * 0.8, b.py - wing, u * 0.5, u * 0.5);
    });
    birds = birds.filter(function(b) { return b.x > -30 && b.x < W + 30; });
    if (birds.length < 3 && Math.random() < 0.003) {
      var fromLeft = Math.random() > 0.5;
      birds.push({x: fromLeft ? -20 : W + 20, py: 20 + Math.random() * H * 0.3, vx: fromLeft ? (0.3 + Math.random() * 0.5) : -(0.3 + Math.random() * 0.5), ph: Math.random() * 6.28});
    }

    /* grass */
    x.fillStyle = '#69b24a';
    x.fillRect(0, gt, W, H - gt);
    x.fillStyle = '#5aa03e';
    for (var g2 = 0; g2 < W; g2 += u * 2) x.fillRect(g2, gt, u, u);
    /* grass blade details */
    x.fillStyle = '#7bc75a';
    for (var g2 = 0; g2 < W; g2 += u * 5) {
      var sway = Math.sin(f * 2 + g2 * 0.1) * u * 0.3;
      x.fillRect(g2 + sway, gt - u * 0.7, u * 0.5, u * 0.7);
    }

    /* flowers */
    flowers.forEach(function(fl) {
      var sway = Math.sin(f * 1.8 + fl.ph) * u * 0.4;
      var sz = u * fl.size;
      /* stem */
      x.fillStyle = '#4a9639';
      x.fillRect(fl.x, gt - sz * 0.5, u * 0.4, sz * 0.6);
      /* petals */
      x.fillStyle = fl.c;
      x.fillRect(fl.x + sway - sz * 0.3, gt - sz * 1.2, sz * 0.5, sz * 0.5);
      x.fillRect(fl.x + sway + sz * 0.2, gt - sz * 1.2, sz * 0.5, sz * 0.5);
      x.fillRect(fl.x + sway - sz * 0.05, gt - sz * 1.5, sz * 0.5, sz * 0.5);
      /* center */
      x.fillStyle = '#ffd64a';
      x.fillRect(fl.x + sway, gt - sz * 1.15, sz * 0.35, sz * 0.35);
    });

    /* dirt */
    x.fillStyle = '#7d4e2c';
    x.fillRect(0, gt + u * 2.2, W, H - (gt + u * 2.2));
    x.fillStyle = '#6a4023';
    var off = (f * 8) % (u * 4);
    for (var g2 = off; g2 < W; g2 += u * 4) {
      x.fillRect(g2, gt + u * 4, u, u);
      x.fillRect(g2 + u * 2, gt + u * 7, u, u);
    }

    /* character movement */
    if (ch.grounded) {
      ch.x += ch.dir * 0.55 * u;
      if (ch.x > W - u * 8) ch.dir = -1;
      if (ch.x < u * 8) ch.dir = 1;
      ch.ft++;
      if (ch.ft > 9) { ch.ft = 0; ch.frame ^= 1; }
    }

    /* auto-speak every ~14 seconds */
    autoTimer++;
    if (ch.sayT <= 0 && autoTimer > 840) {
      ch.sayS = HEROLINES[(Math.random() * HEROLINES.length) | 0];
      ch.sayT = 80;
      autoTimer = 0;
      SND.say(ch.sayS);
    }

    /* jump physics */
    if (!ch.grounded) {
      ch.y += ch.vy;
      ch.vy += 0.55;
      if (ch.y >= 0) { ch.y = 0; ch.vy = 0; ch.grounded = true; }
    }

    var bob = ch.grounded ? Math.sin(f * 8) * 1.5 : 0;
    var mat = ch.frame ? FB : FR;
    var oy = gt - 14 * u + ch.y - bob;

    /* shadow */
    x.fillStyle = 'rgba(0,0,0,0.16)';
    x.beginPath(); x.ellipse(ch.x, gt + u * 1.2, u * 5, u * 1.1, 0, 0, 7); x.fill();

    drawSprite(x, mat, ch.x - 5.5 * u, oy, u, ch.dir < 0);

    /* speech bubble */
    if (ch.sayT > 0) {
      ch.sayT--;
      x.font = "9px 'Press Start 2P',monospace";
      var tw = x.measureText(ch.sayS).width;
      var bw = tw + 16, bh = 22;
      var bx = Math.max(6, Math.min(W - bw - 6, ch.x - bw / 2));
      var by = oy - bh - 10;
      x.fillStyle = '#1d1410'; x.fillRect(bx - 2, by - 2, bw + 4, bh + 4);
      x.fillStyle = '#fbf6ec'; x.fillRect(bx, by, bw, bh);
      x.fillStyle = '#1d1410';
      x.fillRect(ch.x - 3, by + bh, 6, 5);
      x.textAlign = 'center'; x.textBaseline = 'middle';
      x.fillText(ch.sayS, bx + bw / 2, by + bh / 2);
    }

    requestAnimationFrame(frame);
  }

  REFIT.push(build);
  build();
  requestAnimationFrame(frame);
  var to;
  addEventListener('resize', function() { clearTimeout(to); to = setTimeout(build, 200); });
})();

/* ═══ ARCADE tabs ═══ */
(function() {
  var tabs = [].slice.call(document.querySelectorAll('.arc-tab'));
  var pans = [].slice.call(document.querySelectorAll('.arc-panel'));
  tabs.forEach(function(t) {
    t.onclick = function() {
      tabs.forEach(function(x) { x.classList.remove('on'); x.setAttribute('aria-selected', 'false'); });
      pans.forEach(function(p) { p.classList.remove('on'); });
      t.classList.add('on');
      t.setAttribute('aria-selected', 'true');
      document.getElementById(t.dataset.p).classList.add('on');
      SND.blip();
      if (REFIT) REFIT.forEach(function(fn) { try { fn(); } catch(e) {} });
    };
  });
})();

/* ═══ BUILD AN AGENT ═══ */
(function() {
  var palette = document.getElementById('palette');
  if (!palette) return;
  var beltEl = document.getElementById('belt'), logEl = document.getElementById('playResult');
  var btnRun = document.getElementById('btnRun'), btnClear = document.getElementById('btnClear'), cv = document.getElementById('stageCanvas');
  var TOOLS = [
    {id:'lead', ic:'\u26a1', n:'New Lead', k:'trigger', log:'trigger fired: new lead came in from the website form'},
    {id:'mail', ic:'\ud83d\udce9', n:'New Email', k:'trigger', log:'trigger fired: a new email just hit the inbox'},
    {id:'brain', ic:'\ud83e\udde0', n:'AI Brain', k:'agent', log:'agent thinking: reading it, working out intent and the next move'},
    {id:'scrape', ic:'\ud83d\udd0e', n:'Scrape Web', k:'tool', log:'tool: scraped the web and pulled the matching info'},
    {id:'send', ic:'\u2709\ufe0f', n:'Send Email', k:'tool', log:'tool: drafted and sent a reply in about 3 seconds'},
    {id:'book', ic:'\ud83d\udcc5', n:'Book Slot', k:'tool', log:'tool: checked the calendar and booked tue 2pm'},
    {id:'slack', ic:'\ud83d\udcac', n:'Ping Team', k:'tool', log:'tool: pinged the team on slack with the details'},
    {id:'crm', ic:'\ud83d\uddc2\ufe0f', n:'Update CRM', k:'tool', log:'tool: logged the whole thing in the crm'},
    {id:'ship', ic:'\ud83d\ude80', n:'Ship It', k:'output', log:'done: agent is live and running on its own now'}
  ];
  var byId = {};
  TOOLS.forEach(function(t) { byId[t.id] = t; });
  var belt = [], running = false, builds = 0;

  TOOLS.forEach(function(t) {
    var d = document.createElement('div');
    d.className = 'tool'; d.dataset.kind = t.k; d.setAttribute('role', 'button'); d.setAttribute('tabindex', '0');
    d.innerHTML = '<span class="ti">' + t.ic + '</span><span class="tn">' + t.n + '</span>';
    function addTool() {
      if (running) return;
      if (belt.length >= 6) { flash("agent is full mate, hit run \u2192"); return; }
      belt.push(t.id); render(); say('+ ' + t.n.split(' ')[0]); SND.add();
    }
    d.onclick = addTool;
    d.onkeydown = function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); addTool(); } };
    palette.appendChild(d);
  });

  function render() {
    beltEl.innerHTML = '';
    if (!belt.length) { beltEl.innerHTML = '<div class="belt-empty">tap tools to chain them \u2192 (start with a trigger)</div>'; return; }
    belt.forEach(function(id, i) {
      var t = byId[id];
      if (i) { var a = document.createElement('span'); a.className = 'belt-arrow'; a.textContent = '\u25b8'; beltEl.appendChild(a); }
      var b = document.createElement('div'); b.className = 'belt-block';
      b.innerHTML = '<span class="bi">' + t.ic + '</span><span class="bn">' + t.n + '</span>';
      b.title = 'click to remove';
      b.onclick = function() { if (running) return; belt.splice(i, 1); render(); SND.blip(); };
      beltEl.appendChild(b);
    });
  }

  function flash(m) { logEl.innerHTML = '<span class="lg lg-warn">' + m + '</span>'; SND.bad(); }
  function logline(cls, txt) { var d = document.createElement('div'); d.className = 'lg ' + cls; d.textContent = txt; logEl.appendChild(d); logEl.scrollTop = logEl.scrollHeight; }

  btnClear.onclick = function() { if (running) return; belt = []; render(); logEl.innerHTML = ''; SND.blip(); };
  btnRun.onclick = function() {
    if (running) return;
    if (!belt.length) { flash('pick some tools first ya muppet'); say('pick tools!'); return; }
    var hasTrigger = belt.some(function(id) { return byId[id].k === 'trigger'; });
    if (!hasTrigger) { flash('oi, an agent needs a trigger to kick off. add New Lead or New Email first'); say('needs a trigger!'); return; }
    running = true; logEl.innerHTML = ''; logline('lg-head', '\u25b8 RUNNING AGENT...'); SND.blip();
    var blocks = [].slice.call(beltEl.querySelectorAll('.belt-block'));
    var i = 0;
    var step = function() {
      if (i > 0 && blocks[i - 1]) blocks[i - 1].classList.remove('firing');
      if (i < blocks.length) {
        blocks[i].classList.add('firing');
        var t = byId[belt[i]];
        logline('lg-' + t.k, t.log);
        spawnPacket(t.k); hop(); SND.blip();
        i++; setTimeout(step, 640);
      } else finish();
    };
    setTimeout(step, 320);
  };

  function finish() {
    beltEl.querySelectorAll('.belt-block').forEach(function(b) { b.classList.remove('firing'); });
    var hasBrain = belt.some(function(id) { return byId[id].k === 'agent'; });
    var amt = 120 + ((Math.random() * 680) | 0);
    var lv = GAME.lvlUp(); GAME.addCash(amt); builds++;
    if (hasBrain) logline('lg-good', '\u2713 thats a proper agent. it got triggered, thought for itself, used its tools and shipped. +$' + amt + ' (pretend)');
    else logline('lg-warn', '\u2713 it ran, but with no AI Brain thats just a dumb workflow, not a real agent. chuck a brain in so it can actually think. +$' + amt + ' (pretend)');
    burst();
    var ln = ['shipped!','too easy','built different','sending it','boom','no cap'][(Math.random() * 6) | 0];
    say(ln); SND.win(); SND.say(ln);
    if (builds === 1) toast('ACHIEVEMENT \u2014 FIRST AGENT SHIPPED');
    else toast('AGENT SHIPPED \u2014 LV ' + String(lv).padStart(2, '0'));
    running = false;
  }

  var W = 0, H = 0, u = 4, bot = {y: 0, vy: 0, grounded: true}, conf = [], pk = [], sayT = 0, sayS = '';
  var KCOL = {trigger: '#ffd64a', agent: '#34a96a', tool: '#9fd0ef', output: '#e0603a'};

  function buildc() {
    var m = fitCanvas(cv);
    if (!m.ok) { setTimeout(buildc, 120); return; }
    W = m.w; H = m.h; u = Math.max(4, Math.min(8, Math.round(H / 22)));
  }
  function hop() { if (bot.grounded) { bot.vy = -7; bot.grounded = false; } }
  function say(t) { sayS = t; sayT = 70; }
  function spawnPacket(k) { pk.push({t: 0, y: H * 0.4 + (Math.random() * 8 - 4), c: KCOL[k] || '#f2ede1', done: false}); }
  function miniBurst(px, py) { for (var i = 0; i < 14; i++) conf.push({x: px, y: py, vx: (Math.random() - .5) * 5, vy: -Math.random() * 5 - 1, c: ['#e0603a','#f2ede1','#34a96a','#ffd64a'][(Math.random() * 4) | 0], life: 30 + Math.random() * 20}); }
  function burst() { for (var i = 0; i < 90; i++) conf.push({x: W / 2 + (Math.random() - 0.5) * W * 0.5, y: H / 2, vx: (Math.random() - .5) * 10, vy: -Math.random() * 10 - 2, c: ['#e0603a','#f2ede1','#34a96a','#ffd64a','#6ec6f0','#ff85c0'][(Math.random() * 6) | 0], life: 60 + Math.random() * 40}); }

  function frame() {
    if (!canvasVis.stageCanvas) { requestAnimationFrame(frame); return; }
    if (W < 1) { requestAnimationFrame(frame); return; }
    var x = cv.getContext('2d'); x.clearRect(0, 0, W, H); var f = Date.now() / 1000;
    var gy = H - u * 1.5;
    x.fillStyle = '#352b27'; x.fillRect(0, gy, W, u);

    pk.forEach(function(p) {
      p.t += 0.05; var px = 10 + (W / 2 - 10) * Math.min(1, p.t);
      /* trail */
      x.globalAlpha = 0.2; x.fillStyle = p.c;
      x.fillRect(px - u * 3, p.y + u * 0.3, u * 1.5, u * 0.8);
      x.globalAlpha = 0.5;
      x.fillRect(px - u * 1.6, p.y, u * 1.2, u * 1.2);
      x.globalAlpha = 1;
      x.fillRect(px, p.y, u * 1.5, u * 1.5);
      if (p.t >= 1 && !p.done) { p.done = true; hop(); miniBurst(W / 2, p.y); }
    });
    pk = pk.filter(function(p) { return p.t < 1.2; });

    if (!bot.grounded) { bot.y += bot.vy; bot.vy += 0.55; if (bot.y >= 0) { bot.y = 0; bot.vy = 0; bot.grounded = true; } }
    var bob = bot.grounded ? Math.sin(f * 5) * 1.2 : 0;
    var bx = W / 2, oy = gy - 14 * u + bot.y - bob;
    x.fillStyle = 'rgba(0,0,0,0.2)'; x.beginPath(); x.ellipse(bx, gy, u * 5, u, 0, 0, 7); x.fill();
    drawSprite(x, FR, bx - 5.5 * u, oy, u, false);

    if (sayT > 0) {
      sayT--;
      x.font = "8px 'Press Start 2P',monospace";
      var tw = x.measureText(sayS).width, bw = tw + 16, bh = 20;
      var bxb = bx - bw / 2, byb = oy - bh - 8;
      x.fillStyle = '#1d1410'; x.fillRect(bxb - 2, byb - 2, bw + 4, bh + 4);
      x.fillStyle = '#fbf6ec'; x.fillRect(bxb, byb, bw, bh);
      x.fillStyle = '#1d1410'; x.fillRect(bx - 3, byb + bh, 6, 5);
      x.textAlign = 'center'; x.textBaseline = 'middle'; x.fillText(sayS, bx, byb + bh / 2);
    }

    conf.forEach(function(p) { p.vy += 0.22; p.x += p.vx; p.y += p.vy; p.life--; x.globalAlpha = Math.max(0, p.life / 60); x.fillStyle = p.c; x.fillRect(p.x, p.y, u * 0.9, u * 0.9); });
    x.globalAlpha = 1;
    conf = conf.filter(function(p) { return p.life > 0 && p.y < H + 20; });
    requestAnimationFrame(frame);
  }

  buildc(); render(); say('tap a tool!'); requestAnimationFrame(frame); REFIT.push(buildc);
  var to; addEventListener('resize', function() { clearTimeout(to); to = setTimeout(buildc, 200); });
})();

/* ═══ CATCH THE LEADS ═══ */
(function() {
  var cv = document.getElementById('catchCanvas');
  if (!cv) return;
  var btn = document.getElementById('catchBtn'), sEl = document.getElementById('catchScore'), tEl = document.getElementById('catchTime'), bEl = document.getElementById('catchBest'), rEl = document.getElementById('catchResult'), comboEl = document.getElementById('catchCombo');
  var W = 0, H = 0, u = 4, running = false, score = 0, best = 0, timeLeft = 20, combo = 0, maxCombo = 0;
  var coins = [], spawnT = 0, pops = [], last = 0, trails = [];
  var bot = {x: 0, y: 0, vy: 0, grounded: true}, sayT = 0, sayS = '';
  var stars = [];

  function build() {
    var m = fitCanvas(cv);
    if (!m.ok) { setTimeout(build, 120); return; }
    W = m.w; H = m.h; u = Math.max(4, Math.min(8, Math.round(W / 90)));
    if (!bot.x) bot.x = W / 2;
    /* background stars */
    stars = [];
    for (var i = 0; i < 30; i++) stars.push({x: Math.random() * W, y: Math.random() * H * 0.75, ph: Math.random() * 6.28});
  }
  REFIT.push(build);

  function spawn() { var bad = Math.random() < 0.24; coins.push({x: 40 + Math.random() * (W - 80), y: -20, vy: (1.7 + Math.random() * 1.3) * (u / 4), bad: bad, r: u * 4.6, rot: Math.random() * 6.28}); }
  function pop(x, y, col, txt) { pops.push({x: x, y: y, col: col, txt: txt, life: 36}); }
  function say(t) { sayS = t; sayT = 55; }
  function hop() { if (bot.grounded) { bot.vy = -6; bot.grounded = false; } }

  function grab(cx, cy) {
    if (!running) return;
    var bi = -1, bd = 1e9;
    for (var i = 0; i < coins.length; i++) {
      var c = coins[i], d = Math.hypot(cx - c.x, cy - c.y);
      if (d < c.r + u * 3 && d < bd) { bd = d; bi = i; }
    }
    if (bi < 0) return;
    var c = coins[bi];
    if (c.bad) {
      combo = 0;
      score = Math.max(0, score - 1);
      pop(c.x, c.y, '#e0603a', '-1');
      say('spam ay');
      SND.bad();
    } else {
      combo++;
      maxCombo = Math.max(maxCombo, combo);
      var pts = combo >= 5 ? 3 : combo >= 3 ? 2 : 1;
      score += pts;
      pop(c.x, c.y, '#ffd64a', '+' + pts + (combo >= 3 ? ' x' + combo : ''));
      hop();
      SND.coin();
      if (combo === 5) { say('combo!'); SND.say('combo!'); }
      else if (combo === 10) { say('on fire!'); SND.say('on fire!'); }
      /* catch trail burst */
      for (var t = 0; t < 6; t++) trails.push({x: c.x, y: c.y, vx: (Math.random() - .5) * 4, vy: -Math.random() * 3 - 1, c: c.bad ? '#e0603a' : '#ffd64a', life: 20});
    }
    coins.splice(bi, 1);
    bot.x = Math.max(u * 6, Math.min(W - u * 6, c.x));
    sEl.textContent = score;
    comboEl.textContent = combo;
  }

  cv.addEventListener('pointerdown', function(e) { e.preventDefault(); var r = cv.getBoundingClientRect(); grab(e.clientX - r.left, e.clientY - r.top); });

  function start() {
    running = true; score = 0; timeLeft = 20; combo = 0; maxCombo = 0; coins = []; pops = []; trails = []; spawnT = 0;
    sEl.textContent = '0'; tEl.textContent = '20'; comboEl.textContent = '0'; rEl.textContent = '';
    btn.disabled = true; btn.textContent = 'GO!'; last = Date.now(); say('go go go!'); SND.blip(); SND.say('go go go!');
  }
  btn.onclick = function() { if (!running) start(); };

  function end() {
    running = false; best = Math.max(best, score); bEl.textContent = best;
    var cash = score * 40; GAME.addCash(cash);
    var msg = 'time! caught ' + score + ' leads = $' + cash + ' (pretend).';
    if (maxCombo >= 5) msg += ' best combo: x' + maxCombo + '!';
    msg += score > 8 ? ' huge.' : ' go again.';
    rEl.textContent = msg;
    btn.disabled = false; btn.textContent = '\u25b6 PLAY AGAIN';
    say(score > 8 ? 'huge!' : 'again ay');
    if (score > 8) { toast('NICE RUN \u2014 +$' + cash); SND.win(); }
    SND.say(score > 8 ? 'huge run!' : 'go again!');
  }

  function frame() {
    if (!canvasVis.catchCanvas) { requestAnimationFrame(frame); return; }
    if (W < 1) { requestAnimationFrame(frame); return; }
    var x = cv.getContext('2d');
    var now = Date.now(), dt = Math.min(0.05, (now - (last || now)) / 1000); last = now;
    var f = now / 1000;
    x.clearRect(0, 0, W, H);

    /* night sky gradient */
    var g = x.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#0a1520'); g.addColorStop(0.6, '#0e1a26'); g.addColorStop(1, '#1a2e3f');
    x.fillStyle = g; x.fillRect(0, 0, W, H);

    /* stars */
    stars.forEach(function(s) {
      var tw = 0.3 + 0.5 * Math.abs(Math.sin(f * 1.5 + s.ph));
      x.fillStyle = 'rgba(255,255,255,' + tw.toFixed(2) + ')';
      x.fillRect(s.x, s.y, u * 0.4, u * 0.4);
    });

    /* ground */
    var gy = H - u * 2.5;
    x.fillStyle = '#1a3422'; x.fillRect(0, gy, W, H - gy);
    x.fillStyle = '#245232';
    for (var g2 = 0; g2 < W; g2 += u * 2) x.fillRect(g2, gy, u, u);

    if (running) {
      timeLeft -= dt;
      if (timeLeft <= 0) { timeLeft = 0; end(); }
      tEl.textContent = Math.ceil(timeLeft);
      spawnT -= dt;
      if (spawnT <= 0) { spawnT = Math.max(0.40, 0.90 - (20 - timeLeft) * 0.024); spawn(); }
    }

    coins.forEach(function(c) { c.y += c.vy; c.rot += 0.03; });
    coins = coins.filter(function(c) { return c.y < H + 30; });

    coins.forEach(function(c) {
      /* glow */
      x.fillStyle = c.bad ? 'rgba(224,96,58,0.15)' : 'rgba(255,214,74,0.15)';
      x.beginPath(); x.arc(c.x, c.y, c.r * 1.6, 0, 7); x.fill();
      /* shadow */
      x.fillStyle = 'rgba(0,0,0,0.25)';
      x.beginPath(); x.arc(c.x + u * 0.5, c.y + u * 0.5, c.r, 0, 7); x.fill();
      /* coin */
      x.fillStyle = c.bad ? '#e0603a' : '#ffd64a';
      x.beginPath(); x.arc(c.x, c.y, c.r, 0, 7); x.fill();
      /* inner highlight */
      x.fillStyle = c.bad ? '#f27855' : '#ffe98c';
      x.beginPath(); x.arc(c.x - c.r * 0.15, c.y - c.r * 0.15, c.r * 0.65, 0, 7); x.fill();
      /* label */
      x.fillStyle = '#1d1410';
      x.font = "bold " + (c.r * 1.05) + "px 'Press Start 2P',monospace";
      x.textAlign = 'center'; x.textBaseline = 'middle';
      x.fillText(c.bad ? '\u2715' : '$', c.x, c.y + 1);
    });

    /* trails */
    trails.forEach(function(t) { t.x += t.vx; t.y += t.vy; t.vy += 0.15; t.life--; x.globalAlpha = Math.max(0, t.life / 20); x.fillStyle = t.c; x.fillRect(t.x, t.y, u * 0.6, u * 0.6); });
    x.globalAlpha = 1;
    trails = trails.filter(function(t) { return t.life > 0; });

    /* character */
    if (!bot.grounded) { bot.y += bot.vy; bot.vy += 0.5; if (bot.y >= 0) { bot.y = 0; bot.vy = 0; bot.grounded = true; } }
    bot.x = Math.max(u * 6, Math.min(W - u * 6, bot.x));
    var bob = bot.grounded ? Math.sin(f * 5) * 1.2 : 0, oy = gy - 14 * u + bot.y - bob;
    x.fillStyle = 'rgba(0,0,0,0.25)'; x.beginPath(); x.ellipse(bot.x, gy, u * 5, u, 0, 0, 7); x.fill();
    drawSprite(x, FR, bot.x - 5.5 * u, oy, u, false);

    /* speech */
    if (sayT > 0) {
      sayT--;
      x.font = "8px 'Press Start 2P',monospace";
      var tw = x.measureText(sayS).width, bw = tw + 14, bh = 18;
      var bx = Math.max(4, Math.min(W - bw - 4, bot.x - bw / 2)), by = oy - bh - 6;
      x.fillStyle = '#1d1410'; x.fillRect(bx - 2, by - 2, bw + 4, bh + 4);
      x.fillStyle = '#fbf6ec'; x.fillRect(bx, by, bw, bh);
      x.fillStyle = '#1d1410'; x.textAlign = 'center'; x.textBaseline = 'middle';
      x.fillText(sayS, bx + bw / 2, by + bh / 2);
    }

    /* floating +score pops */
    pops.forEach(function(pp) {
      pp.y -= 1.2; pp.life--;
      x.globalAlpha = Math.max(0, pp.life / 36);
      x.fillStyle = pp.col;
      x.font = "bold 13px 'Press Start 2P',monospace";
      x.textAlign = 'center'; x.fillText(pp.txt, pp.x, pp.y);
      x.globalAlpha = 1;
    });
    pops = pops.filter(function(pp) { return pp.life > 0; });

    /* combo indicator on screen */
    if (running && combo >= 3) {
      x.globalAlpha = 0.5 + 0.3 * Math.sin(f * 6);
      x.fillStyle = combo >= 5 ? '#ff85c0' : '#ffd64a';
      x.font = "bold 16px 'Press Start 2P',monospace";
      x.textAlign = 'right'; x.textBaseline = 'top';
      x.fillText('x' + combo, W - 12, 12);
      x.globalAlpha = 1;
    }

    requestAnimationFrame(frame);
  }

  build(); requestAnimationFrame(frame);
  var to; addEventListener('resize', function() { clearTimeout(to); to = setTimeout(build, 200); });
})();

/* ═══ SOLVE IT ═══ */
(function() {
  var qEl = document.getElementById('solveQ'), oEl = document.getElementById('solveOpts');
  var lEl = document.getElementById('solveLesson'), nEl = document.getElementById('solveNext');
  var cEl = document.getElementById('solveCount'), bEl = document.getElementById('solveBubble');
  var cv = document.getElementById('solveCanvas');
  if (!qEl) return;

  var Q = [
    {d:'EASY', q:"what even is an AI agent?", a:["software that takes a goal and acts on its own","a chatbot that only talks when you talk first","a spreadsheet with extra steps"], c:0, l:"an agent takes a goal, picks its own steps and tools, and gets it done."},
    {d:'EASY', q:"a lead messages an hvac biz at 2am. best move?", a:["let it wait till morning","auto reply, qualify, then book the slot","send a plain thanks and stop"], c:1, l:"speed wins. an agent replies in seconds and books while you sleep."},
    {d:'MEDIUM', q:"200 unread support emails. what should the agent do first?", a:["reply to all at once","sort by intent, answer easy ones, flag the rest","just delete the old ones"], c:1, l:"triage first. agents handle the simple stuff, humans get the hard ones."},
    {d:'MEDIUM', q:"an agent keeps giving wrong answers. check first?", a:["buy a bigger model","check the instructions and data you fed it","give up"], c:1, l:"garbage in, garbage out. most agent bugs are bad instructions or missing context."},
    {d:'HARD', q:"when should a task NOT be handed to an agent?", a:["repetitive work with clear rules","a rare high stakes call that needs real judgement","sorting and tagging messages"], c:1, l:"agents shine at repeatable work. rare high stakes calls still want a human."}
  ];

  var i = 0, solved = 0, locked = false, done = false, pose = 'idle', poseT = 0;

  function drawBot() {
    if (!canvasVis.solveCanvas) { requestAnimationFrame(drawBot); return; }
    var m = fitCanvas(cv);
    if (!m.ok) { requestAnimationFrame(drawBot); return; }
    var W = m.w, H = m.h, x = cv.getContext('2d');
    x.clearRect(0, 0, W, H);
    var u = Math.max(4, Math.round(H / 18)), f = Date.now() / 1000;
    var dy = 0, dx = 0;
    if (pose === 'happy') dy = -Math.abs(Math.sin(f * 12)) * 8;
    else if (pose === 'sad') dx = (Math.floor(f * 16) % 2 === 0 ? -2 : 2);
    else dy = Math.sin(f * 4) * 1.5;
    var gy = H - u * 1.5;
    x.fillStyle = 'rgba(0,0,0,0.18)'; x.beginPath(); x.ellipse(W / 2, gy, u * 5, u, 0, 0, 7); x.fill();
    drawSprite(x, FR, W / 2 - 5.5 * u + dx, gy - 14 * u + dy, u, false);
    if (poseT > 0) { poseT--; if (poseT === 0) pose = 'idle'; }
    requestAnimationFrame(drawBot);
  }

  function render() {
    done = false; var s = Q[i]; locked = false;
    qEl.innerHTML = '<span class="solve-diff">' + s.d + '</span>' + s.q;
    oEl.innerHTML = ''; lEl.textContent = ''; nEl.disabled = true;
    nEl.innerHTML = (i === Q.length - 1 ? 'SEE SCORE \u25b6' : 'NEXT \u25b6');
    bEl.textContent = 'your move?';
    cEl.textContent = 'q ' + (i + 1) + '/' + Q.length + ' \u00b7 solved ' + solved;
    s.a.forEach(function(txt, idx) {
      var b = document.createElement('button');
      b.className = 'solve-opt'; b.textContent = txt;
      b.onclick = function() { pick(idx, b, s); };
      oEl.appendChild(b);
    });
  }

  function pick(idx, btn, s) {
    if (locked) return; locked = true;
    var opts = [].slice.call(oEl.children);
    opts.forEach(function(b, k) { b.disabled = true; if (k === s.c) b.classList.add('right'); });
    if (idx === s.c) {
      btn.classList.add('right'); solved++; GAME.addCash(80);
      bEl.textContent = 'yesss'; pose = 'happy'; poseT = 90;
      toast('CORRECT \u2014 +$80'); SND.good(); SND.say('yesss, nailed it!');
    } else {
      btn.classList.add('wrong');
      bEl.textContent = 'nah mate'; pose = 'sad'; poseT = 40;
      SND.bad(); SND.say('nah mate, not that one');
    }
    lEl.textContent = '\u2192 ' + s.l; nEl.disabled = false;
    cEl.textContent = 'q ' + (i + 1) + '/' + Q.length + ' \u00b7 solved ' + solved;
  }

  function endScreen() {
    done = true; var win = solved >= 4;
    qEl.innerHTML = '<span class="solve-diff">' + (win ? 'LEVEL CLEAR' : 'NICE TRY') + '</span>you solved ' + solved + '/' + Q.length;
    oEl.innerHTML = ''; lEl.textContent = '';
    var msg = document.createElement('div'); msg.className = 'solve-end';
    msg.textContent = win ? 'bloody hell, you actually get this agent stuff. respect mate.' : 'yeah nah, have another crack. you will get it, easy.';
    oEl.appendChild(msg);
    var row = document.createElement('div'); row.className = 'solve-end-btns';
    var a1 = document.createElement('a'); a1.href = 'https://t.me/getascent'; a1.target = '_blank'; a1.rel = 'noopener noreferrer'; a1.className = 'pixbtn coral'; a1.innerHTML = '\u25b6 FOLLOW THE JOURNEY';
    var a2 = document.createElement('button'); a2.className = 'pixbtn'; a2.textContent = 'PLAY AGAIN';
    a2.onclick = function() { i = 0; solved = 0; render(); };
    row.appendChild(a1); row.appendChild(a2); oEl.appendChild(row);
    nEl.disabled = true; nEl.innerHTML = 'NEXT \u25b6';
    cEl.textContent = 'solved ' + solved + '/' + Q.length;
    bEl.textContent = win ? 'huge!' : 'again ay';
    pose = win ? 'happy' : 'idle'; poseT = win ? 170 : 0;
    if (win) { toast('LEVEL CLEAR \u2014 NICE ONE'); SND.win(); }
    SND.say(win ? 'bloody hell, you actually get this. respect mate.' : 'have another crack, you will get it.');
  }

  nEl.onclick = function() { if (done) return; if (i === Q.length - 1) endScreen(); else { i++; render(); } };
  render(); requestAnimationFrame(drawBot);
})();

/* ═══ WEEKS level map ═══ */
(function() {
  var g = document.getElementById('weeksGrid');
  if (g) {
    var planned = {3: 1, 5: 1, 7: 1};
    for (var i = 1; i <= 21; i++) {
      var d = document.createElement('div');
      d.className = 'wk' + (i === 1 ? ' cur' : '') + (planned[i] ? ' planned' : '');
      d.dataset.w = i;
      d.setAttribute('role', 'button');
      d.setAttribute('tabindex', '0');
      d.setAttribute('aria-label', 'Week ' + i);
      d.innerHTML = '<span class="wk-n">WK</span><span class="wk-s">' + String(i).padStart(2, '0') + '</span>';
      d.onclick = (function(week) { return function() { SND.blip(); if (window.WEEKMATE) window.WEEKMATE.talk(week); }; })(i);
      d.onkeydown = (function(week) { return function(e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); SND.blip(); if (window.WEEKMATE) window.WEEKMATE.talk(week); } }; })(i);
      g.appendChild(d);
    }
  }

  var cv = document.getElementById('weekCanvas');
  if (!cv) return;
  var W = 0, H = 0, u = 4;

  var LINES = [
    'we doing this for real. follow on socials ay',
    '21 weeks, 10 grand. you watchin or what',
    'this is a mission not a course. follow up',
    'quit lurkin, smash follow and watch it happen',
    'new agent every week. follow the journey',
    'built different over here. go follow ay',
    'oi stop clickin, go hit that follow button',
    'real ones follow along. you in or nah',
    'every week, shipped. thats the deal',
    'no fluff, no filler. just builds',
    'from zero to shipped, every single week',
    'come along for the ride legend'
  ];

  var st = {active: false, x: 0, dir: 1, frame: 0, ft: 0, phase: 'in', target: 0, sayS: '', talkT: 0, pendingSpeak: false, fromLeft: true};

  function build() {
    var m = fitCanvas(cv);
    if (!m.ok) { setTimeout(build, 120); return; }
    W = m.w; H = m.h; u = Math.max(4, Math.min(7, Math.round(W / 170)));
  }

  function talk(week) {
    var base = LINES[(Math.random() * LINES.length) | 0];
    var line = (week ? ('week ' + String(week).padStart(2, '0') + '? ') : '') + base;
    if (!st.active) {
      st.active = true; st.fromLeft = Math.random() < 0.5;
      st.x = st.fromLeft ? -u * 8 : W + u * 8;
      st.target = W * 0.5; st.phase = 'in';
    } else if (st.phase === 'out') {
      st.phase = 'in'; st.target = W * 0.5;
    }
    st.sayS = line; st.pendingSpeak = true;
  }
  window.WEEKMATE = {talk: talk};

  cv.addEventListener('click', function(e) {
    var r = cv.getBoundingClientRect();
    var cx = e.clientX - r.left;
    if (!st.active || Math.abs(cx - st.x) < u * 11) talk(0);
  });

  function frame() {
    if (!canvasVis.weekCanvas) { requestAnimationFrame(frame); return; }
    if (W < 1) { requestAnimationFrame(frame); return; }
    var x = cv.getContext('2d'); x.clearRect(0, 0, W, H);
    var f = Date.now() / 1000, gy = H - u * 2;

    if (!st.active) {
      x.fillStyle = 'rgba(242,237,225,0.32)';
      x.font = "9px 'Press Start 2P',monospace";
      x.textAlign = 'center'; x.textBaseline = 'middle';
      x.fillText('tap a week, i will come \u2191', W / 2, H / 2);
      requestAnimationFrame(frame); return;
    }

    if (st.phase === 'in') {
      st.x += (st.target - st.x) * 0.12;
      st.dir = (st.target > st.x) ? 1 : -1;
      st.ft++;
      if (st.ft > 8) { st.ft = 0; st.frame ^= 1; }
      if (Math.abs(st.x - st.target) < u * 1.4) {
        st.phase = 'talk'; st.talkT = 200;
        if (st.pendingSpeak) { SND.say(st.sayS); st.pendingSpeak = false; }
      }
    } else if (st.phase === 'talk') {
      if (st.pendingSpeak) { SND.say(st.sayS); st.pendingSpeak = false; st.talkT = 200; }
      st.talkT--;
      if (st.talkT <= 0) { st.phase = 'out'; st.target = (st.x < W / 2) ? -u * 9 : W + u * 9; }
    } else if (st.phase === 'out') {
      st.x += (st.target - st.x) * 0.1;
      st.dir = (st.target > st.x) ? 1 : -1;
      st.ft++;
      if (st.ft > 8) { st.ft = 0; st.frame ^= 1; }
      if (st.x < -u * 8 || st.x > W + u * 8) st.active = false;
    }

    var bob = Math.sin(f * 7) * 1.3, mat = st.frame ? FB : FR;
    var oy = gy - 14 * u - bob;
    x.fillStyle = 'rgba(0,0,0,0.25)'; x.beginPath(); x.ellipse(st.x, gy + u * 0.6, u * 5, u, 0, 0, 7); x.fill();
    drawSprite(x, mat, st.x - 5.5 * u, oy, u, st.dir < 0);

    if (st.phase === 'talk' && st.sayS) {
      x.font = "7px 'Press Start 2P',monospace";
      var tw = x.measureText(st.sayS).width;
      var bw = Math.min(W - 12, tw + 16), bh = 18;
      var bx = Math.max(6, Math.min(W - bw - 6, st.x - bw / 2)), by = oy - bh - 12;
      x.fillStyle = '#1d1410'; x.fillRect(bx - 2, by - 2, bw + 4, bh + 4);
      x.fillStyle = '#fbf6ec'; x.fillRect(bx, by, bw, bh);
      x.fillStyle = '#1d1410'; x.fillRect(st.x - 3, by + bh, 6, 5);
      x.textAlign = 'center'; x.textBaseline = 'middle';
      x.fillText(st.sayS, bx + bw / 2, by + bh / 2);
    }
    requestAnimationFrame(frame);
  }

  build(); requestAnimationFrame(frame); REFIT.push(build);
  var to; addEventListener('resize', function() { clearTimeout(to); to = setTimeout(build, 200); });
})();

/* ═══ EMAIL + MARQUEE ═══ */
(function() {
  var b = document.getElementById('emailBtn'), inp = document.getElementById('emailIn'), m = document.getElementById('emailMsg');
  if (b) b.onclick = function() {
    var v = (inp.value || '').trim();
    if (!v || v.indexOf('@') < 0 || v.indexOf('.') < 0) {
      m.style.color = '#ffd64a'; m.textContent = 'drop a real email yeah?'; SND.bad(); return;
    }
    m.style.color = '#34a96a'; m.textContent = 'youre in. see you every week.';
    inp.value = '';
    toast('PLAYER JOINED \u2014 SEE YOU WEEKLY');
    SND.win(); SND.say('welcome aboard legend!');
  };
  var mq = document.getElementById('mq');
  if (mq) {
    var s = '';
    for (var i = 0; i < 10; i++) s += '<span class="marquee-item">BUILD THE DAMN THING</span>';
    mq.innerHTML = s + s;
  }
})();

/* ═══ SOUND TOGGLE ═══ */
(function() {
  var b = document.getElementById('hudSnd');
  if (!b) return;
  b.onclick = function() {
    var o = SND.toggle();
    b.innerHTML = o ? '\ud83d\udd0a' : '\ud83d\udd07';
    b.setAttribute('aria-label', o ? 'Sound on, click to mute' : 'Sound off, click to unmute');
    if (o) SND.blip();
  };
})();

/* ═══ INIT — safe canvas sizing ═══ */
(function() {
  function fire() { try { window.dispatchEvent(new Event('resize')); } catch(e) {} }
  requestAnimationFrame(fire);
  [150, 500, 1200].forEach(function(ms) { setTimeout(fire, ms); });
  window.addEventListener('load', fire);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fire);
})();
</script>
</body>
</html>
