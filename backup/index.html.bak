<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Build The Damn Thing — Learn AI Agents From Scratch</title>
<meta name="description" content="21-week public challenge to learn and build AI agents from scratch. $10K goal. One new agent shipped every week. Come watch, come play.">
<meta property="og:title" content="Build The Damn Thing">
<meta property="og:description" content="Learn AI agents from scratch. $10K in 21 weeks. Building live.">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Build The Damn Thing">
<meta name="twitter:description" content="Learn AI agents from scratch. $10K in 21 weeks. Building live.">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='4' fill='%23e0603a'/><rect x='8' y='6' width='4' height='20' fill='%23f2ede1'/><rect x='12' y='6' width='8' height='3' fill='%23f2ede1'/><rect x='20' y='9' width='3' height='4' fill='%23f2ede1'/><rect x='12' y='13' width='8' height='3' fill='%23f2ede1'/><rect x='20' y='16' width='3' height='4' fill='%23f2ede1'/><rect x='12' y='23' width='8' height='3' fill='%23f2ede1'/><rect x='20' y='20' width='3' height='3' fill='%23f2ede1'/></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Pixelify+Sans:wght@400;500;600;700&family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
/* ===== RESET & VARIABLES ===== */
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#252525;--bg2:#2c2c2c;--bg3:#20201e;--ink:#1d1410;--cream:#f2ede1;--cream2:#fbf6ec;
  --coral:#e0603a;--green:#34a96a;--yellow:#ffd64a;--sky:#7cc6ee;
  --line:rgba(242,237,225,.13);--muted:rgba(242,237,225,.6);
  --pix:'Press Start 2P',monospace;--head:'Pixelify Sans',sans-serif;--body:'Inter',sans-serif;
}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--bg);color:var(--cream);line-height:1.6;overflow-x:hidden}
img{image-rendering:pixelated}
a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--yellow);outline-offset:2px}
.skip-link{position:absolute;top:-100%;left:16px;z-index:999;font-family:var(--pix);font-size:10px;background:var(--yellow);color:var(--ink);padding:10px 16px;text-decoration:none;border:2px solid var(--ink)}
.skip-link:focus{top:8px}
.wrap{max-width:1440px;margin:0 auto;padding:0 32px}
h2,h3{font-family:var(--head);font-weight:700;letter-spacing:.5px;line-height:1.08}
.eyebrow{font-family:var(--pix);font-size:9px;color:var(--coral);letter-spacing:1.5px;display:inline-block;margin-bottom:18px}
.pixbtn{font-family:var(--pix);font-size:11px;border:3px solid var(--ink);box-shadow:5px 5px 0 var(--ink);background:var(--cream2);color:var(--ink);padding:14px 20px;cursor:pointer;text-decoration:none;display:inline-block;line-height:1.4;transition:transform .06s,box-shadow .06s}
.pixbtn:hover{transform:translate(2px,2px);box-shadow:3px 3px 0 var(--ink)}
.pixbtn:active{transform:translate(5px,5px);box-shadow:0 0 0 var(--ink)}
.pixbtn.green{background:var(--green);color:#0e2c1c;border-color:#0e2c1c;box-shadow:5px 5px 0 #0e2c1c}
.pixbtn.coral{background:var(--coral);color:#fff;box-shadow:5px 5px 0 var(--ink)}
.pixbtn:disabled{opacity:.55;cursor:default;transform:none;box-shadow:5px 5px 0 var(--ink)}

/* ===== HUD BAR ===== */
nav.hud-bar{position:fixed;top:0;left:0;right:0;z-index:400;height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;background:#16171a;border-bottom:3px solid var(--coral)}
.hud-grp{display:flex;align-items:center;gap:14px}
.hearts{display:flex;gap:3px}.hearts svg{display:block}
.hud-name{font-family:var(--pix);font-size:9px;color:var(--cream);letter-spacing:1px}
.hud-stat{font-family:var(--pix);font-size:8px;color:var(--yellow);letter-spacing:1px;transition:transform .15s}
.hud-stat.bump{transform:scale(1.25);color:#fff}
.hud-start{font-family:var(--pix);font-size:8px;color:#0e2c1c;background:var(--green);border:2px solid #0e2c1c;padding:8px 11px;text-decoration:none;box-shadow:3px 3px 0 #0e2c1c;transition:transform .06s,box-shadow .06s}
.hud-start:hover{transform:translate(1px,1px);box-shadow:2px 2px 0 #0e2c1c}
.hud-snd{font-size:13px;background:transparent;border:2px solid rgba(242,237,225,.25);color:var(--cream);padding:6px 8px;cursor:pointer;line-height:1;transition:border-color .15s}
.hud-snd:hover{border-color:var(--coral)}

/* ===== HERO ===== */
.hero{height:100vh;min-height:560px;position:relative;overflow:hidden;border-bottom:4px solid var(--ink);background:var(--sky)}
.hero-canvas{position:absolute;inset:0;z-index:1;image-rendering:pixelated;cursor:pointer}
.hero-ui{position:absolute;z-index:5;top:14%;left:0;right:0;text-align:center;padding:0 20px;pointer-events:none}
.hero-ui a{pointer-events:auto}
.hero-eyebrow{font-family:var(--pix);display:inline-block;font-size:9px;background:var(--yellow);color:var(--ink);padding:9px 13px;border:2px solid var(--ink);box-shadow:3px 3px 0 rgba(0,0,0,.35);margin-bottom:26px;animation:float 3s ease-in-out infinite}
.hero-title{font-family:var(--head);font-weight:700;font-size:clamp(42px,8.5vw,108px);line-height:.9;color:var(--cream2);text-shadow:4px 4px 0 var(--ink),7px 7px 0 rgba(224,96,58,.55);letter-spacing:1px;margin-bottom:22px}
.hero-tag{font-family:var(--head);font-size:clamp(16px,1.9vw,24px);color:#15212e;font-weight:600;margin-bottom:32px}
.hero-tag span{background:var(--coral);color:#fff;padding:1px 8px}
.press-start{font-family:var(--pix);display:inline-block;font-size:clamp(10px,1.3vw,13px);background:var(--cream2);color:var(--ink);border:3px solid var(--ink);padding:16px 28px;text-decoration:none;box-shadow:6px 6px 0 var(--ink);animation:psblink 1.6s steps(1) infinite}
.press-start:hover{transform:translate(2px,2px);box-shadow:4px 4px 0 var(--ink);animation:none}
@keyframes psblink{0%,72%{opacity:1}73%,86%{opacity:.5}87%,100%{opacity:1}}
.hero-poke{font-family:var(--pix);margin-top:24px;font-size:8px;color:#15212e;opacity:.85}
.hero-hint{font-family:var(--pix);position:absolute;bottom:22px;left:0;right:0;text-align:center;font-size:8px;color:#15212e;z-index:5;animation:hbob 1.2s ease-in-out infinite}
@keyframes hbob{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}

/* ===== SECTIONS ===== */
.sec{padding:96px 0;border-bottom:1px solid var(--line)}
.sec-head{margin-bottom:48px}
.sec-head h2{font-size:clamp(30px,4.4vw,52px)}
.js .sec{opacity:0;transform:translateY(28px);transition:opacity .55s ease,transform .55s ease}
.js .sec.visible{opacity:1;transform:none}
.js .hero{opacity:1;transform:none}

/* ===== SPLIT CARDS ===== */
.split{display:grid;grid-template-columns:1fr 1fr;gap:26px}
.split-card{background:var(--bg2);border:2px solid var(--coral);box-shadow:6px 6px 0 rgba(0,0,0,.4);padding:36px 32px;transition:transform .12s,box-shadow .12s}
.split-card:hover{transform:translate(-3px,-3px);box-shadow:9px 9px 0 rgba(0,0,0,.4)}
.split-card .tag{font-family:var(--pix);font-size:9px;color:var(--yellow);display:block;margin-bottom:16px}
.split-card h3{font-size:26px;margin-bottom:14px;color:var(--cream2)}
.split-card p{color:var(--muted);font-size:15.5px}

/* ===== ARCADE ===== */
.arcade{background:#202024;border-top:4px solid var(--ink);border-bottom:4px solid var(--ink)}
.arcade .wrap{max-width:1520px}
.arc-intro{text-align:center;margin-bottom:32px}
.arc-intro h2{font-size:clamp(30px,5vw,56px);color:var(--cream2)}
.arc-intro p{color:var(--muted);margin-top:12px;font-size:15px}
.arc-tabs{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:34px}
.arc-tab{font-family:var(--pix);font-size:10px;padding:13px 16px;border:2px solid var(--line);background:var(--bg3);color:var(--muted);cursor:pointer;transition:.12s}
.arc-tab:hover{color:var(--cream);border-color:rgba(242,237,225,.3)}
.arc-tab.on{background:var(--coral);color:#fff;border-color:var(--ink);box-shadow:4px 4px 0 var(--ink),0 0 18px rgba(224,96,58,.3);transform:translate(-1px,-1px)}
.arc-panel{display:none;animation:fade .25s ease}
.arc-panel.on{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1}}
.game-box{background:var(--bg3);border:3px solid var(--ink);box-shadow:8px 8px 0 rgba(0,0,0,.45);padding:26px}
.game-h{font-family:var(--head);font-size:24px;color:var(--cream2);margin-bottom:4px}
.game-sub{color:var(--muted);font-size:13px;margin-bottom:22px}

/* ===== BUILD GAME ===== */
.build-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:22px;align-items:start}
.palette{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.tool{display:flex;flex-direction:column;align-items:center;gap:7px;padding:13px 8px;border:2px solid var(--line);background:var(--bg2);cursor:pointer;position:relative;transition:.1s}
.tool:hover{border-color:var(--coral);transform:translateY(-3px);box-shadow:0 4px 12px rgba(224,96,58,.2)}
.tool::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--coral)}
.tool[data-kind="trigger"]::before{background:var(--yellow)}
.tool[data-kind="agent"]::before{background:var(--green)}
.tool[data-kind="output"]::before{background:var(--sky)}
.ti{font-size:24px;line-height:1}
.tn{font-family:var(--pix);font-size:8px;color:var(--cream);text-align:center}
.stage-wrap{display:flex;flex-direction:column;gap:14px}
#stageCanvas{width:100%;height:208px;background:#15140f;border:2px solid var(--line);image-rendering:pixelated;display:block}
.belt{display:flex;flex-wrap:wrap;gap:6px;align-items:center;min-height:56px;background:var(--bg2);border:2px solid var(--line);padding:10px}
.belt-empty{font-family:var(--pix);color:var(--muted);font-size:8px;padding:6px}
.belt-block{display:flex;align-items:center;gap:6px;padding:8px 10px;border:2px solid var(--coral);background:var(--bg3);cursor:pointer;transition:.12s}
.belt-block.firing{background:var(--green);border-color:var(--green);transform:scale(1.1);box-shadow:0 0 18px rgba(52,169,106,.85)}
.bi{font-size:15px}.bn{font-family:var(--pix);font-size:8px;color:var(--cream)}
.belt-arrow{color:var(--coral);font-size:13px}
.build-ctrls{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
#playResult{font-family:var(--pix);font-size:8.5px;line-height:1.65;margin-top:14px;background:#15140f;border:2px solid var(--line);padding:12px;max-height:160px;overflow:auto;min-height:54px}
#playResult .lg{margin-bottom:6px;color:var(--cream)}
#playResult .lg-head{color:var(--yellow)}
#playResult .lg-trigger{color:var(--yellow)}
#playResult .lg-agent{color:#bff0d4}
#playResult .lg-tool{color:#9fd0ef}
#playResult .lg-output{color:var(--coral)}
#playResult .lg-good{color:#bff0d4}
#playResult .lg-warn{color:var(--yellow)}

/* ===== CATCH GAME ===== */
.catch-hud{display:flex;gap:22px;margin-bottom:16px;font-family:var(--pix);font-size:10px}
.catch-hud b{color:var(--yellow)}
#catchCanvas{width:100%;height:380px;border:2px solid var(--line);image-rendering:pixelated;display:block;cursor:crosshair;background:#0e1a26}
.catch-foot{display:flex;gap:16px;align-items:center;flex-wrap:wrap;margin-top:16px}
#catchResult{font-family:var(--pix);font-size:9px;color:var(--green);line-height:1.7}

/* ===== SOLVE GAME ===== */
.solve-grid{display:grid;grid-template-columns:120px 1fr;gap:24px;align-items:start}
#solveCanvas{width:120px;height:140px;image-rendering:pixelated;background:var(--bg2);border:2px solid var(--line)}
.solve-canvas-wrap{display:flex;flex-direction:column;gap:8px;align-items:center}
.solve-bubble{font-family:var(--pix);font-size:8px;color:var(--cream);background:var(--ink);border:2px solid var(--coral);padding:6px 8px;text-align:center;min-height:26px;width:120px}
.solve-q{font-family:var(--head);font-size:21px;color:var(--cream2);margin-bottom:18px;line-height:1.25}
.solve-diff{font-family:var(--pix);font-size:8px;color:var(--coral);background:rgba(224,96,58,.14);border:1px solid var(--coral);padding:4px 7px;margin-right:10px;vertical-align:middle;display:inline-block;margin-bottom:7px}
.solve-opts{display:flex;flex-direction:column;gap:10px}
.solve-opt{text-align:left;font-family:var(--body);font-size:14.5px;padding:13px 16px;border:2px solid var(--line);background:var(--bg2);color:var(--cream);cursor:pointer;transition:.12s}
.solve-opt:hover{border-color:var(--coral);background:rgba(224,96,58,.06)}
.solve-opt.right{border-color:var(--green);background:rgba(52,169,106,.16);color:#bff0d4}
.solve-opt.wrong{border-color:var(--coral);background:rgba(224,96,58,.16)}
.solve-opt:disabled{cursor:default}
.solve-lesson{font-family:var(--pix);font-size:9px;line-height:1.7;color:var(--yellow);margin-top:16px;min-height:18px}
.solve-foot{margin-top:18px;display:flex;gap:12px;align-items:center}
.solve-count{font-family:var(--pix);font-size:8px;color:var(--muted)}
.solve-end{font-family:var(--head);font-weight:600;font-size:19px;color:var(--cream2);margin-bottom:18px;line-height:1.4}
.solve-end-btns{display:flex;gap:12px;flex-wrap:wrap}

/* ===== QUOTE ===== */
.quote-box{max-width:920px;margin:0 auto;background:var(--bg2);border:3px solid var(--coral);box-shadow:9px 9px 0 rgba(0,0,0,.4);padding:46px 44px}
.quote-box .lbl{font-family:var(--pix);font-size:9px;color:var(--coral);margin-bottom:18px;display:block}
.quote-box p{font-size:clamp(18px,2.3vw,26px);color:var(--cream2);font-weight:300;line-height:1.5}
.cursor{display:inline-block;width:11px;height:22px;background:var(--coral);vertical-align:-3px;margin-left:3px;animation:bl 1s steps(1) infinite}
@keyframes bl{50%{opacity:0}}

/* ===== AGENT CARDS ===== */
.cards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:3px solid var(--ink);background:var(--ink)}
.card{background:var(--bg2);padding:0;border:1px solid var(--ink);transition:transform .15s,box-shadow .15s}
.card:hover{transform:translateY(-4px);box-shadow:0 8px 24px rgba(0,0,0,.35)}
.card-thumb{height:150px;background:#15140f;border-bottom:2px solid var(--ink);display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap;padding:14px}
.flow-node{font-family:var(--pix);font-size:7px;color:var(--cream);border:2px solid var(--line);padding:8px 9px;background:var(--bg3);transition:border-color .3s}
.card:hover .flow-node{border-color:var(--coral)}
.flow-node.ag{border-color:var(--green);color:#bff0d4}
.card:hover .flow-node.ag{border-color:#5edb96}
.flow-dash{color:var(--coral);letter-spacing:2px;font-size:10px}
.card-body{padding:26px 24px}
.card-tag{font-family:var(--pix);font-size:8px;color:var(--cream);background:var(--bg3);border:1px solid var(--line);padding:6px 9px;display:inline-block;margin-bottom:14px}
.card-date{font-family:var(--pix);font-size:8px;color:var(--muted);display:block;margin-bottom:10px}
.card-name{font-family:var(--head);font-weight:700;font-size:22px;color:var(--cream2);margin-bottom:12px}
.card-body p{color:var(--muted);font-size:14.5px}

/* ===== ASK ===== */
.ask{text-align:center}
.ask h2{font-size:clamp(28px,4.2vw,46px);color:var(--cream2);margin-bottom:14px}
.ask p{color:var(--muted);max-width:560px;margin:0 auto 28px;font-size:15.5px}

/* ===== WHO ===== */
.who-grid{display:grid;grid-template-columns:1fr 1fr;gap:66px}
.who-grid h2{font-size:clamp(30px,4.4vw,50px);color:var(--cream2);margin-bottom:32px}
.who-p{color:var(--muted);font-size:15.5px;margin-bottom:24px;line-height:1.95}
.who-p strong{color:var(--cream2);font-weight:600}
.who-p:last-child{margin-bottom:0}
.chips{display:flex;flex-wrap:wrap;gap:9px;margin-top:32px}
.chip{font-family:var(--pix);font-size:8px;padding:9px 11px;border:2px solid var(--line);color:var(--muted);transition:border-color .2s,color .2s}
.chip:hover{border-color:var(--cream);color:var(--cream)}
.chip.w{color:var(--cream);border-color:var(--cream)}
.chip.g{color:#bff0d4;border-color:var(--green)}
.chip.g:hover{box-shadow:0 0 12px rgba(52,169,106,.3)}

/* ===== WEEKS ===== */
.weeks-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:9px;border:3px solid var(--coral);background:var(--ink);padding:14px;width:100%;margin:0 auto}
#journey .wrap{max-width:1520px}
.wk{aspect-ratio:1.7;background:var(--bg3);display:flex;flex-direction:column;align-items:center;justify-content:center;border:1px solid var(--line);cursor:pointer;transition:transform .1s,border-color .15s,box-shadow .15s}
.wk:hover{transform:scale(1.06);border-color:var(--coral);box-shadow:0 0 14px rgba(224,96,58,.25);z-index:2}
.wk-n{font-family:var(--pix);font-size:6px;color:var(--muted)}
.wk-s{font-family:var(--pix);font-size:14px;color:var(--cream);margin-top:2px}
.wk.planned{border-color:var(--coral)}
.wk.cur{background:var(--green);animation:weekpulse 2s ease-in-out infinite}
.wk.cur .wk-n{color:rgba(14,44,28,.65)}.wk.cur .wk-s{color:#0e2c1c}
@keyframes weekpulse{0%,100%{box-shadow:0 0 0 rgba(52,169,106,0)}50%{box-shadow:0 0 18px rgba(52,169,106,.5)}}
#weekCanvas{width:100%;height:118px;display:block;margin:18px auto 0;image-rendering:pixelated;cursor:pointer}
.weeks-legend{display:flex;gap:20px;margin-top:16px;font-family:var(--pix);font-size:8px;color:var(--muted);flex-wrap:wrap;justify-content:center}
.weeks-legend i{display:inline-block;width:11px;height:11px;vertical-align:-1px;margin-right:6px}

/* ===== EMAIL ===== */
.email-box{background:var(--bg2);border:3px solid var(--ink);box-shadow:9px 9px 0 var(--coral);padding:46px 40px;max-width:760px;margin:0 auto;text-align:center}
.email-box h2{font-size:clamp(26px,3.6vw,40px);color:var(--cream2);margin-bottom:12px}
.email-box p{color:var(--muted);margin-bottom:26px}
.email-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.email-in{font-family:var(--pix);font-size:9px;padding:15px 16px;background:var(--bg3);border:2px solid var(--line);color:var(--cream);min-width:260px;transition:border-color .15s}
.email-in:focus{outline:none;border-color:var(--coral)}

/* ===== FOOTER ===== */
footer{background:#141518;border-top:4px solid var(--coral);padding:70px 0 30px}
.foot-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px}
.foot-name{font-family:var(--head);font-weight:700;font-size:26px;color:var(--cream2);margin-bottom:12px}
.foot-blurb{color:rgba(242,237,225,.72);font-size:14px;max-width:300px}
.foot-col h4{font-family:var(--pix);font-size:8px;color:var(--yellow);margin-bottom:16px;letter-spacing:1px}
.foot-col a{display:block;color:rgba(242,237,225,.66);text-decoration:none;font-size:14px;margin-bottom:10px;transition:color .12s}
.foot-col a:hover{color:var(--cream2)}
.marquee{overflow:hidden;border-top:2px solid rgba(242,237,225,.1);border-bottom:2px solid rgba(242,237,225,.1);padding:18px 0;margin-top:50px;white-space:nowrap}
.marquee-track{display:inline-block;animation:scroll 26s linear infinite}
.marquee-item{font-family:var(--head);font-weight:700;font-size:34px;color:rgba(224,96,58,.22);margin:0 26px}
@keyframes scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.foot-bottom{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin-top:40px;padding-top:24px;border-top:1px solid rgba(242,237,225,.12)}
.foot-bottom span{font-family:var(--pix);font-size:8px;color:rgba(242,237,225,.55)}
.socials{display:flex;gap:10px;flex-wrap:wrap}
.socials a{width:34px;height:34px;border:2px solid rgba(242,237,225,.22);display:flex;align-items:center;justify-content:center;color:rgba(242,237,225,.66);text-decoration:none;font-size:13px;transition:.15s}
.socials a:hover{background:var(--coral);border-color:var(--coral);color:#fff;transform:translateY(-2px)}

/* ===== TOAST ===== */
#toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(40px);z-index:500;background:var(--green);color:#0e2c1c;border:3px solid #0e2c1c;box-shadow:5px 5px 0 #0e2c1c;font-family:var(--pix);font-size:9px;padding:13px 18px;opacity:0;transition:.3s;pointer-events:none}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ===== RESPONSIVE ===== */
@media(max-width:1024px){
  .cards-grid{grid-template-columns:1fr 1fr}
  .who-grid{gap:44px}
}
@media(max-width:860px){
  .split,.who-grid{grid-template-columns:1fr}
  .build-grid{grid-template-columns:1fr}
  .cards-grid{grid-template-columns:1fr}
  .foot-grid{grid-template-columns:1fr 1fr}
  .who-grid{gap:38px}
  .sec{padding:72px 0}
}
@media(max-width:700px){
  .hud-name{display:none}
  .hud-stat{font-size:7px}
  .hud-start{font-size:7px;padding:7px 9px}
  .hero-ui{top:12%}
  .palette{grid-template-columns:repeat(2,1fr)}
  .solve-grid{grid-template-columns:1fr}
  .solve-canvas-wrap{flex-direction:row;justify-content:center}
  .weeks-grid{grid-template-columns:repeat(5,1fr)}
  .foot-grid{grid-template-columns:1fr}
  .wrap{padding:0 18px}
  .sec{padding:56px 0}
}
@media(max-width:560px){
  .wk{aspect-ratio:1.35}
  .weeks-grid{grid-template-columns:repeat(4,1fr)}
  .hero{min-height:500px}
}
</style>
</head>
<body>

<a href="#arcade" class="skip-link">Skip to game zone</a>

<nav class="hud-bar" role="navigation" aria-label="Game HUD">
  <div class="hud-grp">
    <span class="hearts" aria-label="3 lives remaining">
      <svg width="15" height="13" viewBox="0 0 7 6" aria-hidden="true"><g fill="#e0603a"><rect x="1" width="2" height="1"/><rect x="4" width="2" height="1"/><rect y="1" width="7" height="2"/><rect x="1" y="3" width="5" height="1"/><rect x="2" y="4" width="3" height="1"/><rect x="3" y="5" width="1" height="1"/></g></svg>
      <svg width="15" height="13" viewBox="0 0 7 6" aria-hidden="true"><g fill="#e0603a"><rect x="1" width="2" height="1"/><rect x="4" width="2" height="1"/><rect y="1" width="7" height="2"/><rect x="1" y="3" width="5" height="1"/><rect x="2" y="4" width="3" height="1"/><rect x="3" y="5" width="1" height="1"/></g></svg>
      <svg width="15" height="13" viewBox="0 0 7 6" aria-hidden="true"><g fill="#e0603a"><rect x="1" width="2" height="1"/><rect x="4" width="2" height="1"/><rect y="1" width="7" height="2"/><rect x="1" y="3" width="5" height="1"/><rect x="2" y="4" width="3" height="1"/><rect x="3" y="5" width="1" height="1"/></g></svg>
    </span>
    <span class="hud-name">BUILD THE DAMN THING</span>
  </div>
  <div class="hud-grp">
    <span class="hud-stat" id="hudLV" aria-live="polite">LV 00</span>
    <span class="hud-stat" id="hudMoney" aria-live="polite">$0/$10K</span>
    <button class="hud-snd" id="hudSnd" title="Toggle sound on/off" aria-label="Toggle sound">&#128266;</button>
    <a href="#email-section" class="hud-start">&#9654; FOLLOW</a>
  </div>
</nav>

<section class="hero" aria-label="Hero banner">
  <canvas class="hero-canvas" id="heroCanvas" aria-label="Interactive pixel art scene with walking character. Click to interact."></canvas>
  <div class="hero-ui">
    <div class="hero-eyebrow">&#9654; NEW CHALLENGE &middot; STARTS JUL 1 2026</div>
    <h1 class="hero-title">BUILD THE<br>DAMN THING</h1>
    <p class="hero-tag">learning AI agents from scratch. <span>$10K in 21 weeks.</span> building live.</p>
    <a href="#arcade" class="press-start">&#9654; PRESS START</a>
    <div class="hero-poke">psst &middot; tap the little guy</div>
  </div>
  <div class="hero-hint">scroll down to play &darr;</div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="split">
      <div class="split-card">
        <span class="tag">&#9654; THE CHALLENGE</span>
        <h3>learn it live</h3>
        <p>learn to build AI agents from scratch, fully in public. 21 weeks. one new agent shipped every single week. everything straight from the raw docs. no fluff, no shortcuts, no pretending i already know it all.</p>
      </div>
      <div class="split-card">
        <span class="tag">&#9654; THE BET</span>
        <h3>make 10 grand doing it</h3>
        <p>make $10k inside 21 weeks while learning. a founder who already builds, now picking up a new craft out loud. building live, failing live, getting paid live. starts jul 1 2026.</p>
      </div>
    </div>
  </div>
</section>

<section class="sec arcade" id="arcade" aria-label="Game Zone">
  <div class="wrap">
    <div class="arc-intro">
      <span class="eyebrow">&#9654; THE GAME ZONE</span>
      <h2>come play. build stuff.</h2>
      <p>this is a playground, not a pitch. mess around, build a fake agent, catch some leads, solve a puzzle. none of it is real, all of it teaches you how agents actually work.</p>
    </div>
    <div class="arc-tabs" role="tablist">
      <button class="arc-tab on" data-p="pBuild" role="tab" aria-selected="true">&#129302; BUILD AN AGENT</button>
      <button class="arc-tab" data-p="pCatch" role="tab" aria-selected="false">&#9889; CATCH THE LEADS</button>
      <button class="arc-tab" data-p="pSolve" role="tab" aria-selected="false">&#129504; SOLVE IT</button>
    </div>

    <div class="arc-panel on" id="pBuild" role="tabpanel">
      <div class="game-box">
        <div class="game-h">build an agent</div>
        <div class="game-sub">tap pixel tools to chain them up, hit run, and watch the little guy ship it. just for fun.</div>
        <div class="build-grid">
          <div>
            <div class="palette" id="palette"></div>
          </div>
          <div class="stage-wrap">
            <canvas id="stageCanvas" aria-label="Agent building stage"></canvas>
            <div class="belt" id="belt"></div>
            <div class="build-ctrls">
              <button class="pixbtn green" id="btnRun">&#9654; RUN</button>
              <button class="pixbtn" id="btnClear">CLEAR</button>
            </div>
            <div id="playResult" aria-live="polite"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="arc-panel" id="pCatch" role="tabpanel">
      <div class="game-box">
        <div class="game-h">catch the leads</div>
        <div class="game-sub">click the gold $ leads as they drop. dodge the spam &#10005;. you have 20 seconds. this is what speed-to-lead feels like.</div>
        <div class="catch-hud">
          <span>SCORE <b id="catchScore">0</b></span>
          <span>TIME <b id="catchTime">20</b></span>
          <span>BEST <b id="catchBest">0</b></span>
          <span>COMBO <b id="catchCombo">0</b></span>
        </div>
        <canvas id="catchCanvas" aria-label="Catch the leads game"></canvas>
        <div class="catch-foot">
          <button class="pixbtn coral" id="catchBtn">&#9654; START</button>
          <span id="catchResult"></span>
        </div>
      </div>
    </div>

    <div class="arc-panel" id="pSolve" role="tabpanel">
      <div class="game-box">
        <div class="game-h">solve it</div>
        <div class="game-sub">real agent problems, picked apart. choose the smart move and learn why it wins.</div>
        <div class="solve-grid">
          <div class="solve-canvas-wrap">
            <canvas id="solveCanvas" aria-label="Quiz mascot"></canvas>
            <div class="solve-bubble" id="solveBubble">your move?</div>
          </div>
          <div>
            <div class="solve-q" id="solveQ"></div>
            <div class="solve-opts" id="solveOpts"></div>
            <div class="solve-lesson" id="solveLesson"></div>
            <div class="solve-foot">
              <button class="pixbtn" id="solveNext" disabled>NEXT &#9654;</button>
              <span class="solve-count" id="solveCount"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="quote-box">
      <span class="lbl">&#9654; WHAT IS AN AI AGENT?</span>
      <p>software that can think, decide and take action on its own. you give it a goal, it figures out the steps, picks its tools, and gets the job done while you sleep. that is the thing being built here. every week. from scratch.<span class="cursor"></span></p>
    </div>
  </div>
</section>

<section class="sec" id="agents">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">&#9654; THE AGENTS</span><h2>the build list</h2></div>
    <div class="cards-grid">
      <div class="card">
        <div class="card-thumb"><span class="flow-node">CALL</span><span class="flow-dash">&#9656;&#9656;</span><span class="flow-node ag">AGENT</span><span class="flow-dash">&#9656;&#9656;</span><span class="flow-node">BOOK</span></div>
        <div class="card-body">
          <span class="card-tag">AGENT 01 &middot; PLANNED</span>
          <span class="card-date">TARGETING &mdash; WEEK 3</span>
          <div class="card-name">hvac speed-to-lead agent</div>
          <p>when a customer calls or messages an hvac company, the agent answers instantly, qualifies the job, and books it on the calendar. no missed leads, day or night.</p>
        </div>
      </div>
      <div class="card">
        <div class="card-thumb"><span class="flow-node">SCRAPE</span><span class="flow-dash">&#9656;&#9656;</span><span class="flow-node ag">AGENT</span><span class="flow-dash">&#9656;&#9656;</span><span class="flow-node">SCORE</span></div>
        <div class="card-body">
          <span class="card-tag">AGENT 02 &middot; PLANNED</span>
          <span class="card-date">TARGETING &mdash; WEEK 5</span>
          <div class="card-name">lead generation agent</div>
          <p>finds, scores and routes leads. pipeline running without you lifting a finger.</p>
        </div>
      </div>
      <div class="card">
        <div class="card-thumb"><span class="flow-node">INBOX</span><span class="flow-dash">&#9656;&#9656;</span><span class="flow-node ag">AGENT</span><span class="flow-dash">&#9656;&#9656;</span><span class="flow-node">REPLY</span></div>
        <div class="card-body">
          <span class="card-tag">AGENT 03 &middot; PLANNED</span>
          <span class="card-date">TARGETING &mdash; WEEK 7</span>
          <div class="card-name">email support agent</div>
          <p>reads incoming emails, decides what to do, replies or flags. most of the inbox runs itself.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sec">
  <div class="wrap ask">
    <span class="eyebrow">&#9654; PLAYER INPUT</span>
    <h2>what should i build next?</h2>
    <p>got an agent idea, a problem worth solving, or just wanna follow along? send it over. i actually read these.</p>
    <a href="https://t.me/getascent" target="_blank" rel="noopener noreferrer" class="pixbtn coral">&#9654; MESSAGE ME ON TELEGRAM</a>
  </div>
</section>

<section class="sec" id="who">
  <div class="wrap who-grid">
    <div>
      <span class="eyebrow">&#9654; WHO IS BEHIND THIS</span>
      <h2>Ahmed.<br>your biz growth mate.</h2>
      <div class="chips">
        <span class="chip w">Founder</span>
        <span class="chip w">B2B Growth Partner</span>
